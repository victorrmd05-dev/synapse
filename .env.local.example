# =============================================================================
# Alavanca Synapse — modelo de variáveis de ambiente
#
# Copie para `.env.local` e preencha. O `.env.local` NUNCA é commitado
# (está no .gitignore como `.env*.local`); ESTE arquivo é a documentação.
#
# ⚠️ Ao adicionar uma variável nova ao `.env.local`, adicione o NOME aqui também
#    — sem o valor. Este arquivo é o que diz a alguém (ou a você daqui a três
#    meses) o que o projeto precisa para rodar.
#
# ⚠️ Variável de ambiente do WINDOWS SOBREPÕE este arquivo. O Next não
#    sobrescreve `process.env` já setado, e a falha é SILENCIOSA. Já custou uma
#    sessão inteira: havia SUPABASE_SERVICE_ROLE_KEY apontando para outro projeto
#    no ambiente do usuário. Se algo não pega, confira as env do sistema.
# =============================================================================

# ── Banco (Supabase) ─────────────────────────────────────────────────────────
# URL e anon key são públicas (vão pro browser). A service_role IGNORA RLS e é
# server-only — nunca importar no client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Chaves novas do Supabase (publishable/secret), quando migrar do par acima.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Conexão direta ao Postgres (migrations/scripts).
DATABASE_URL=

# ── IA ───────────────────────────────────────────────────────────────────────
# 💸 O provider PADRÃO é o OpenCode Zen (gratuito). Anthropic e OpenAI só entram
#    por escolha explícita — ver a política de custo no CLAUDE.md.
OPENCODE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Opcionais: forçam modelo específico. Vazio = default do código.
OPENAI_MODEL=
OPENAI_DESIGN_MODEL=
# 'zen' (grátis, default) | 'anthropic' | 'openai' — os dois últimos SÃO PAGOS.
DESIGN_PROVIDER=

# ── Mineração e pesquisa ─────────────────────────────────────────────────────
# ⚠️ SCRAPE_CREATORS_API_KEY, com underscore entre SCRAPE e CREATORS.
SCRAPE_CREATORS_API_KEY=
FIRECRAWL_API_KEY=
SCRAPINGBEE_API_KEY=
TAVILY_API_KEY=

# ── Meta Ads ─────────────────────────────────────────────────────────────────
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_APP_ID=
META_APP_SECRET=

# ── Tracking (FOP) ───────────────────────────────────────────────────────────
# Relay CAPI que vai ASSADO dentro da LP publicada. Sem isto, uma instalação
# feita a partir do localhost assaria `http://localhost:3000/...` no HTML e o
# lado servidor morreria para todo visitante — em silêncio.
# Ex: https://<projeto>.supabase.co/functions/v1/track-capi
TRACKING_CAPI_ENDPOINT=

# ── Publicação de landing pages (Cloudflare) ─────────────────────────────────
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL=

# ── Git (sync de agentes / deploy) ───────────────────────────────────────────
# ⚠️ A conta correta é victorrmd05-dev. Ver a seção GIT do CLAUDE.md.
GITHUB_TOKEN=
GITHUB_USERNAME=
GITHUB_EMAIL=
GITHUB_REPO=

# ── Vídeo ────────────────────────────────────────────────────────────────────
# Narração das variações de vídeo geradas pelo Remotion (pasta `remotion/`).
ELEVENLABS_API_KEY=
